MIRROR_LISTEN_ADDR=:8080
MIRROR_SERVER_NAME=Mythic Mirror
MIRROR_IMPL_NAME=mythic-mirror
MIRROR_DATABASE_URL=postgres://mirror:mirror@localhost:5432/mirror?sslmode=disable
MIRROR_KEY_PATH=data/private.pem
MIRROR_TEXTURES_DIR=data/textures
MIRROR_SKIN_DOMAINS=localhost
MIRROR_TEXTURES_BASE_URL=http://localhost:8080
MIRROR_BASE_URL=http://localhost:8080
MIRROR_WEB_URL=http://localhost:3101
# CORS 允许来源（逗号分隔）；留空则用 MIRROR_WEB_URL，再空回退 *（仅开发）
MIRROR_CORS_ORIGINS=
MIRROR_LOCALE=en-US
MIRROR_CAPTCHA_DRIVER=
MIRROR_CAPTCHA_SECRET=
MIRROR_OAUTH_GITHUB_CLIENT_ID=
MIRROR_OAUTH_GITHUB_CLIENT_SECRET=
MIRROR_OAUTH_MICROSOFT_CLIENT_ID=
MIRROR_OAUTH_MICROSOFT_CLIENT_SECRET=
MIRROR_INVITE_ONLY=false
MIRROR_DISABLE_REGISTRATION=false
MIRROR_EMAIL_DOMAIN_WHITELIST=
MIRROR_STORAGE_DRIVER=local
MIRROR_S3_ENDPOINT=
MIRROR_S3_REGION=auto
MIRROR_S3_BUCKET=
MIRROR_S3_ACCESS_KEY=
MIRROR_S3_SECRET_KEY=
MIRROR_MAIL_DRIVER=log
MIRROR_SMTP_ADDR=
MIRROR_SMTP_FROM=
MIRROR_SMTP_USER=
MIRROR_SMTP_PASS=
MIRROR_RESEND_API_KEY=
MIRROR_RESEND_FROM=
MIRROR_CDN_DRIVER=
MIRROR_CLOUDFLARE_ZONE_ID=
MIRROR_CLOUDFLARE_API_KEY=
MIRROR_BUNNY_API_KEY=
MIRROR_CDN_WEBHOOK_URL=
MIRROR_RATE_LIMIT_RPS=100
MIRROR_RATE_LIMIT_BURST=200
MIRROR_ADMIN_TOKEN=
MIRROR_REDIS_ADDR=

# 客户端 IP 解析（限流/日志防伪造，见 shared/clientip）
# 可信代理网段（CIDR/IP，逗号分隔）；留空=默认信任环回+私网+链路本地
# CDN/云 LB 场景必须把边缘网段加进来（如 Cloudflare 的 IP 段）
MIRROR_TRUSTED_PROXIES=
# 转发头查询顺序（逗号分隔）；留空=X-Forwarded-For,X-Real-IP,CF-Connecting-IP,True-Client-IP
MIRROR_CLIENT_IP_HEADERS=
# 应用直接暴露公网（无任何反代）时设 true，完全忽略转发头
MIRROR_CLIENT_IP_TRUST_NONE=false

# 配额：默认存储上限（字节，0=不限，默认 64MiB）
MIRROR_QUOTA_STORAGE_BYTES=67108864
# 按用户 storage_tier 覆盖存储上限（JSON 映射，如 {"pro":1073741824}）
MIRROR_QUOTA_TIERS=
# 皮肤库发布数量上限（0=不限，默认 100）
MIRROR_QUOTA_PUBLISHED=100
# 开启后新发布皮肤进入审核队列（under_review），管理员批准后才公开
MIRROR_SKIN_REVIEW=false
